{
  "uid": "if3110-m2-observability",
  "title": "IF3110 M2 — Migration Queue, DB Pool & Correlated Logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "tags": ["if3110", "migration", "postgres", "observability"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Migration Jobs by Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max by (status) (dbplatform_migration_jobs)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Retries / Batches / Rows Processed",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(dbplatform_migration_job_retries_total)",
          "legendFormat": "Retries",
          "refId": "A"
        },
        {
          "expr": "sum(dbplatform_migration_batches_processed_total)",
          "legendFormat": "Batches",
          "refId": "B"
        },
        {
          "expr": "sum(dbplatform_migration_rows_processed_total)",
          "legendFormat": "Rows",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue Wait & DB Lock Wait Time (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dbplatform_migration_queue_wait_seconds_sum[2m])) / clamp_min(sum(rate(dbplatform_migration_queue_wait_seconds_count[2m])), 1e-9)",
          "legendFormat": "Avg Queue Wait (s)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dbplatform_migration_lock_wait_seconds_sum[2m])) / clamp_min(sum(rate(dbplatform_migration_lock_wait_seconds_count[2m])), 1e-9)",
          "legendFormat": "Avg DB Lock Wait (s)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Migration Execution Duration by Status (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(dbplatform_migration_duration_seconds_sum[2m])) / clamp_min(sum by (status) (rate(dbplatform_migration_duration_seconds_count[2m])), 1e-9)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Database Connection Pool (Active vs Idle)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max by (pool, state) (dbplatform_db_pool_connections)",
          "legendFormat": "{{pool}} ({{state}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database Connection Pool Wait Time (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(dbplatform_db_pool_wait_seconds_total[2m])",
          "legendFormat": "{{pool}} wait (s/sec)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Centralized Application & SQL Logs (OTel Collector -> Loki)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=~\"if3110-.*\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
