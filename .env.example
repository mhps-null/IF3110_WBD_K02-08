# Application
APP_ENV=development
ADDR=:8080

# Metadata PostgreSQL database
DATABASE_URL=postgres://if3110_user:CHANGE_ME@localhost:5432/if3110_wbd_k02_08?sslmode=disable

# Generate a random secret with: openssl rand -hex 32
SESSION_SECRET=

# Keep false for local HTTP development.
# Production requires HTTPS and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false

# Initial Platform Admin; fill before running cmd/seed.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Dedicated PostgreSQL integration-test database.
# Fill this before running tests with -tags=integration.
TEST_DATABASE_URL=
