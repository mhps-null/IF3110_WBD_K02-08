# Application
APP_ENV=development
ADDR=:8080
SPA_DIST_DIR=frontend/dist

# Metadata PostgreSQL database
DATABASE_URL=postgres://if3110_user:CHANGE_ME@localhost:5432/if3110_wbd_k02_08?sslmode=disable

# Generate a random secret with: openssl rand -hex 32
SESSION_SECRET=

# Keep false for local HTTP development.
# Production requires HTTPS and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false

# Generate a random 32-byte AES key with: openssl rand -base64 32
# Required to encrypt/decrypt connection passwords stored in metadata.
DB_ENCRYPTION_KEY=

# Initial Platform Admin; fill before running cmd/seed.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Dedicated PostgreSQL integration-test database.
# Fill this before running tests with -tags=integration.
TEST_DATABASE_URL=

# Multi-DBMS integration testing (Docker test containers)
TEST_MYSQL_URL=
TEST_MARIADB_URL=

# Async migration worker (cmd/worker). DATABASE_URL and DB_ENCRYPTION_KEY above
# are shared with the API. WORKER_ID defaults to <hostname>-<random>.
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_METRICS_ADDR=:9091
WORKER_LEASE=30s
WORKER_POLL_INTERVAL=500ms
WORKER_RETRY_BASE=2s
WORKER_RETRY_MAX=1m
WORKER_LOCK_TIMEOUT=30s
